# Copie para scripts/provision.env. Nunca versione este arquivo.
# [PREENCHER] informe valor real. [AJUSTÁVEL] pode manter padrão.
# [GERADO] não preencher: Terraform/script retorna após o deploy.

# [PREENCHER] Identidade e ambiente OCI
OCI_CLI_PROFILE=DEFAULT
OCI_FUNCTIONS_CONTEXT=sa-saopaulo-1
TF_VAR_tenancy_ocid=ocid1.tenancy.oc1..example
TF_VAR_compartment_ocid=ocid1.compartment.oc1..example
TF_VAR_region=sa-saopaulo-1
TF_VAR_adb_admin_password=troque-por-uma-senha-forte
TF_VAR_api_jwt_issuer=https://identity-domain.example.com
TF_VAR_api_jwt_audience=edacqrs-api
TF_VAR_api_jwks_uri=https://identity-domain.example.com/admin/v1/SigningCert/jwk

# [AJUSTÁVEL] Convenção: <project>-<environment>-<componente>
TF_VAR_project=edacqrs
TF_VAR_environment=dev

# [PREENCHER] Kafka: valores realmente oferecidos na região OCI.
TF_VAR_kafka_version=<versao-kafka-disponivel>
TF_VAR_kafka_coordination_type=<tipo-compativel-com-versao>

# [AJUSTÁVEL] Produção: PRODUCTION e pelo menos três brokers.
TF_VAR_kafka_cluster_type=PRODUCTION
TF_VAR_kafka_broker_node_count=3
TF_VAR_kafka_broker_ocpu_count=1
TF_VAR_kafka_broker_storage_gbs=500
TF_VAR_kafka_topic_partitions=6

# [PREENCHER] Banco, OKE, imagens OCIR e credenciais SASL.
DB_USER=APP_USER
DB_PASSWORD=troque-por-uma-senha-forte
DB_DSN=edacqrs_high
DB_PASSWORD_SECRET_OCID=ocid1.vaultsecret.oc1..precriado-no-vault
OKE_CLUSTER_OCID=ocid1.cluster.oc1..example
CONSUMER_IMAGE=sa-saopaulo-1.ocir.io/namespace/orders-projection@sha256:substitua
PUBLISHER_IMAGE=sa-saopaulo-1.ocir.io/namespace/orders-publisher@sha256:substitua
KAFKA_USERNAME=<usuario-SASL-provisionado-no-cluster>
KAFKA_AUTH_TOKEN=obtenha-do-vault

# [PRÉ-REQUISITO OKE] Workload Identity + OCI Vault CSI devem estar habilitados.
# Crie externamente o Secret/SecretProviderClass `edacqrs-runtime` a partir do Vault.
# O script não aceita mais senha/token diretamente em Kubernetes Secret.

# [GERADO AUTOMATICAMENTE — NÃO PREENCHER]
# kafka_cluster_ocid, kafka_bootstrap_servers, kafka_topic,
# kafka_topic_replication_factor, adb_ocid, gateway_id,
# command_application_id e projection_application_id.
# Consulte todos após deploy: terraform -chdir=terraform output
# O script também cria <project>.<environment>.orders.domain.v1 e <topic>.dlq.

# [PREENCHER] Sem APPLY=1, o script interrompe antes de criar recursos.
APPLY=0
